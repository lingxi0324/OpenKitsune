import sys;sys.path.insert(0,'.');from sizhu_predictor import predict_month,PLATES;ACTUAL={'木':[-12,8,-3,-3,-5,-10,-8,-6,25,0,-4,-3],'火':[-18,15,8,-4,-8,-12,-15,-8,37,12,-7,-4],'土':[-8,2,-3,0,-2,-2,-3,-5,30,4,-3,-1],'金':[2,0,2,-2,-1,1,0,-1,12,5,2,0],'水':[3,-1,-1,0,1,2,1,0,-8,-2,0,1]};results={};for p in PLATES:;hits=0;total=12;monthly=[];for m in range(1,13):;pred=predict_month(p,2024,m);act=ACTUAL[p][m-1];dir_pred=pred['direction'];dir_act='涨' if act else '微涨' if act else '震荡' if act==0 else '微跌' if act else '跌';match='✅' if dir_pred==dir_act or (dir_pred in('涨','微涨') and dir_act in('涨','微涨')) or (dir_pred in('跌','微跌') and dir_act in('跌','微跌')) else '❌';hits+=1 if match=='✅' else 0;monthly.append(f"{m:02d}月:推{dir_pred}({pred['score']})实{act:+.0f}%{match}");results[p]={'hits':hits,'acc':hits/total*100,'detail':monthly};print('=== 四柱引擎 · 2024月度回测 ===');[print(f"\n{p}板块: {r['hits']}/{total}={r['acc']:.0f}%")+[print(f"  {d}") for d in r['detail']] for p,r in results.items()];total_hits=sum(r['hits'] for r in results.values());print(f"\n总吻合: {total_hits}/60={total_hits/60*100:.1f}%") 
